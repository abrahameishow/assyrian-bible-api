{
    "chapterEn": "Chapter 37",
    "chapterAs": "ܩܦܠܐܘܢ: ܠܙ.",
    "verses": [
        {
            "verseNumberEn": "1",
            "verseNumberAs": "ܐ",
            "verseText": "ܘܬܘܼܪܸܨܠܹܐ ܒܲܨܠܝܼܐܹܝܠ ܠܩܹܒ̣ܘܼܬܵܐ ܕܩܲܝܣܹ̈ܐ ܕܫܸܛܝܼܡ: ܬܪܵܝ ܝܲܡܝܼܢܹ̈ܐ ܘܦܲܠܓܹܐ ܝܘܼܪܟ̣ܘܼܬܘܼܗ̇: ܘܝܲܡܝܼܢܵܐ ܘܦܲܠܓܹܐ ܦܸܬܝܘܼܬܘܼܗ̇: ܘܝܲܡܝܼܢܵܐ ܘܦܲܠܓܹܐ ܪܵܡܘܼܬܘܼܗ̇."
        },
        {
            "verseNumberEn": "2",
            "verseNumberAs": "ܒ",
            "verseText": "ܘܩܪܝܼܡܵܠܹܐ ܕܲܗܒ̣ܵܐ ܨܸܦܝܵܐ ܡ̣ܢ ܠܓܵܘܵܝܝܼ ܘܡ̣ܢ ܠܒܲܕܲܪ: ܘܬܘܼܪܸܨܠܹܐ ܩܵܬܘܼܗ̇ ܟܠܝܼܠܵܐ ܕܕܲܗܒ̣ܵܐ ܚܵܕܸܪ̈ܘܵܢܹܐ."
        },
        {
            "verseNumberEn": "3",
            "verseNumberAs": "ܓ",
            "verseText": "ܘܪܡܹܠܹܐ ܩܵܬܘܼܗ̇ ܐܲܪܒܲܥ ܗܵܠܲܩܝܵܬܹ̈ܐ ܕܕܲܗܒ̣ܵܐ: ܥܲܠ ܐܲܪܒܲܥ ܐܲܩܠܵܬܘܼ̈ܗ̇: ܬܪܵܝ ܗܵܠܲܩܝܵܬܹ̈ܐ ܥܲܠ ܚܵܐ ܓܹܒܘܼܗ̇: ܘܬܪܵܝ ܗܵܠܲܩܝܵܬܹ̈ܐ ܥܲܠ ܕܗ̇ܘ ܓܹܒܘܼܗ̇ ܐ݇ܚܹܪ݇ܢܵܐ."
        },
        {
            "verseNumberEn": "4",
            "verseNumberAs": "ܕ",
            "verseText": "ܘܬܘܼܪܸܨܠܹܐ ܕܝܼܘܲܢܝܵܬܹ̈ܐ ܕܩܲܝܣܹ̈ܐ ܕܫܸܛܝܼܡ: ܩܪܝܼܡܵܝܠܹܐ ܕܲܗܒ̣ܵܐ."
        },
        {
            "verseNumberEn": "5",
            "verseNumberAs": "ܗ",
            "verseText": "ܘܡܘܼܐܘܸܪܹܐ ܠܕܝܼܘܲܢܝܵܬܹ̈ܐ ܒܗܵܠܲܩܝܵܬܹ̈ܐ ܥܲܠ ܓܹܒܵܢܹ̈ܐ ܕܩܹܒ̣ܘܼܬܵܐ: ܠܸܛܥܵܢܵܐ ܠܩܹܒ̣ܘܼܬܵܐ."
        },
        {
            "verseNumberEn": "6",
            "verseNumberAs": "ܘ",
            "verseText": "ܘܬܘܼܪܸܨܠܹܐ ܚܘܼܣܵܝܵܐ ܕܕܲܗܒ̣ܵܐ ܨܸܦܝܵܐ: ܬܪܵܝ ܝܲܡܝܼ̈ܢܹܐ ܘܦܲܠܓܹܐ ܝܘܼܪܟ̣ܘܼܬܘܼܗܝ: ܘܝܲܡܝܼܢܵܐ ܘܦܲܠܓܹܐ ܦܸܬܝܘܼܬܘܼܗܝ."
        },
        {
            "verseNumberEn": "7",
            "verseNumberAs": "ܙ",
            "verseText": "ܘܬܘܼܪܸܨܠܹܐ ܬܪܵܝ ܟܪ̈ܘܿܒܹܐ ܕܕܲܗܒ̣ܵܐ: ܦܘܼܠܚܵܢܵܐ ܕܚܲܪܵܛ ܬܘܼܪܨܵܝܠܹܐ: ܒܬܸܪ̈ܘܵܝ ܪܹ̈ܫܵܢܹܐ ܕܚܘܼܣܵܝܵܐ:"
        },
        {
            "verseNumberEn": "8",
            "verseNumberAs": "ܚ",
            "verseText": "ܚܵܐ ܒܪܘܿܒ̣ܵܐ ܒܐܵܗܵܐ ܪܹܫܵܐ: ܘܚܵܐ ܟܪܘܿܒ̣ܵܐ ܒܗ̇ܘ ܪܹܫܵܐ: ܡ̣ܢ ܚܘܼܣܵܝܵܐ ܬܘܼܪܸܨܠܹܐ ܟܪ̈ܘܿܒܹܐ ܒܬܸܪܘܵܝ ܪܹ̈ܫܵܢܘܼܗܝ."
        },
        {
            "verseNumberEn": "9",
            "verseNumberAs": "ܛ",
            "verseText": "ܘܟܪ̈ܘܿܒܹܐ ܦܪܝܼܣܹܐ ܗ݇ܘܵܘ ܓܘܼܠܦܵܢܹ̈ܐ ܠܥܘܼܠܘܼܠ: ܟܵܣܘܿܘܹܐ ܒܓܘܼܠܦܵܢܵܝ̈ ܥܲܠ ܚܘܼܣܵܝܵܐ: ܘܦܵܬ̈ܘܵܬܵܝ ܚܵܐ ܠܵܕܗ̇ܘ ܐ݇ܚܹܪ݇ܢܵܐ: ܠܵܚܘܼܣܵܝܵܐ ܗ݇ܘܵܘ ܦܵܬܘܵܬܹ̈ܐ ܕܟܪ̈ܘܿܒܹܐ."
        },
