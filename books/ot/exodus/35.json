{
    "chapterEn": "Chapter 35",
    "chapterAs": "ܩܦܠܐܘܢ: ܠܗ.",
    "verses": [
        {
            "verseNumberEn": "1",
            "verseNumberAs": "ܐ",
            "verseText": "ܘܓ̰ܘܼܡܸܥܠܹܐ ܡܘܼܫܹܐ ܠܟ̇ܠܵܗ̇ ܓ̰ܵܡܵܥܲܬ ܕܒܢܲܝ̈ ܝܼܣܪܵܝܹܠ: ܘܐ݇ܡܸܪܹܐ ܐܸܠܵܝ: ܐܲܢܹܐ ܝ݇ܢܵܐ ܗܹܡܸܙܡܵܢܹ̈ܐ ܕܦܩܸܕܠܹܐ ܡܵܪܝܵܐ ܠܸܥܒ̣ܵܕܵܝ."
        },
        {
            "verseNumberEn": "2",
            "verseNumberAs": "ܒ",
            "verseText": "ܐܸܫܬܵܐ ܝܘܿܡܵܢܹ̈ܐ ܦܵܝܸܫ ܥܒ̣ܝܼܕܵܐ ܦܘܼܠܚܵܢܵܐ: ܘܒܝܘܿܡܵܐ ܕܫܲܒ̣ܥܵܐ ܗܵܘܹܐ ܐܸܠܵܘܟ̣ܘܿܢ ܩܘܼܕܫܵܐ: ܫܲܒܵܬ ܫܲܒܵܬܘܿܢ ܠܡܵܪܝܵܐ. ܟܠ ܕܥܵܒܸܕ ܒܝ̣ܹܗ ܦܘܼܠܚܵܢܵܐ: ܦܵܝܸܫ ܡܘܼܡܝܸܬܵܐ."
        },
        {
            "verseNumberEn": "3",
            "verseNumberAs": "ܓ",
            "verseText": "ܠܵܐ ܬܵܦܝܼܬܘܿܢ ܢܘܼܪܵܐ ܓܵܘ ܟܠܵܝ ܡܲܣܟܵܢܵܘ̈ܟ̣ܘܿܢ ܒܝܘܿܡܵܐ ܕܫܲܒܵܬ."
        },
        {
            "verseNumberEn": "4",
            "verseNumberAs": "ܕ",
            "verseText": "ܘܐ݇ܡܸܪܹܐ ܡܘܼܫܹܐ ܠܟ̇ܠܵܗ̇ ܓ̰ܵܡܵܥܲܬ ܕܒܢܲܝ̈ ܝܼܣܪܵܝܹܠ: ܒܹܐܡܵܪܵܐ: ܐܵܗܵܐ ܝ݇ܠܹܐ ܚܲܒ̇ܪܵܐ ܕܦܩܸܕܠܹܐ ܡܵܪܝܵܐ: ܒܹܐܡܵܪܵܐ:"
        },
        {
            "verseNumberEn": "5",
            "verseNumberAs": "ܗ",
            "verseText": "ܫܩܘܿܠܘܿܢ ܡ̣ܢ ܓܵܘܵܘܟ̣ܘܿܢ ܦܘܼܪܫܵܢܵܐ ܠܡܵܪܝܵܐ. ܟܠ ܕܝܼܠܹܐ ܪܵܙܝܼ ܠܸܒܘܼܗܝ: ܡܲܐܝܹܐ ܠܹܗ ܦܘܼܪܫܵܢܵܐ ܕܡܵܪܝܵܐ: ܕܲܗܒ̣ܵܐ: ܘܣܹܐܡܵܐ: ܘܢܚܵܫܵܐ:"
        },
        {
            "verseNumberEn": "6",
            "verseNumberAs": "ܘ",
            "verseText": "ܘܡܝܼܠܵܐ: ܘܐܲܪܓܘܵܢܵܐ: ܘܩܸܪܡܝܼܙ: ܘܟܸܬܵܢ ܢܵܙܸܟ: ܘܣܲܥܪܵܐ ܕܥܸܙܹ̈ܐ:"
        },
        {
            "verseNumberEn": "7",
            "verseNumberAs": "ܙ",
            "verseText": "ܘܓܸܠܕܹ̈ܐ ܕܒܲܪ̈ܥܵܢܹܐ ܡܘܼܣܡܸܩܹ̈ܐ: ܘܓܸܠܕܹ̈ܐ ܕܬܲܚܫܹ̈ܐ: ܘܩܲܝܣܹ̈ܐ ܕܫܸܛܝܼܡ:"
        },
        {
            "verseNumberEn": "8",
            "verseNumberAs": "ܚ",
            "verseText": "ܘܡܸܫܚܵܐ ܩܵܐ ܒܲܗܪܵܐ: ܘܐܲܕܘܹ̈ܐ ܩܵܐ ܡܸܫܚܵܐ ܕܡܫܵܚܬܵܐ: ܘܩܵܐ ܒܸܣܡܵܐ ܪܹܝܚܵܢܵܐ:"
        },
        {
            "verseNumberEn": "9",
            "verseNumberAs": "ܛ",
            "verseText": "ܘܟܹܐܦܹ̈ܐ ܕܫܘܼܗܲܡ: ܘܟܹܐܦܹ̈ܐ ܕܦܲܝܫܝܼ ܡܘܼܠܚܸܡܹܐ ܩܵܐ ܐܸܦܘܿܕܵܐ ܘܩܵܐ ܒܪܵܬ݇ ܨܲܕܪܵܐ."
        },
        {
            "verseNumberEn": "10",
            "verseNumberAs": "ܝ",
            "verseText": "ܘܟ̇ܠ ܥܵܩܸܠܕܵܪ ܕܠܸܒܵܐ ܓܵܘܵܘܟ̣ܘܿܢ ܐܵܬܝܼ: ܘܬܵܪܨܝܼ ܠܟ̇ܠ ܕܦܩܸܕܠܹܐ ܡܵܪܝܵܐ:"
        },
        {
            "verseNumberEn": "11",
            "verseNumberAs": "ܝܐ",
            "verseText": "ܠܡܵܫܸܟ̇ܢܵܐ: ܠܟ̰ܼܿܕܪܘܼܗܝ: ܘܠܟܵܣܵܝܬܘܼܗܝ: ܘܠܦܸܫܟܘܼ̈ܙ̃ܘܼܗܝ: ܘܠܕܲܦܘܼ̈ܗܝ: ܠܦܘܼܫܬܹܒ̣ܵܢܘܼ̈ܗܝ: ܠܣܛܘܼܢܘܼ̈ܗܝ: ܘܠܣܵܡܟܘܼ̈ܗܝ:"
        },
        {
            "verseNumberEn": "12",
            "verseNumberAs": "ܝܒ",
            "verseText": "ܠܩܹܒ̣ܘܼܬܵܐ: ܘܠܕܝܼܘܲܢܝܵܬ̈ܘܼܗ̇: ܠܚܘܼܣܵܝܵܐ: ܘܠܣܸܬܪܵܐ ܕܡܵܟܲܣܬܵܐ:"
        },
        {
            "verseNumberEn": "13",
            "verseNumberAs": "ܝܓ",
            "verseText": "ܠܦܵܬܘܿܪܵܐ: ܘܠܕܝܼܘܲܢܝܵܬ̈ܘܼܗܝ: ܘܠܟ̇ܠܵܝ ܡܵܐܢܘܼ̈ܗܝ: ܘܠܠܚܸܡ ܐܲܦܹ̈ܐ:"
        },
        {
            "verseNumberEn": "14",
            "verseNumberAs": "ܝܕ",
            "verseText": "ܘܠܩܲܢܕܝܼܠܵܐ ܕܒܲܗܪܵܐ: ܘܠܡܵܐܢܘܼ̈ܗܝ: ܘܠܫܪ̈ܵܝܵܬܘܼܗܝ: ܘܠܡܸܫܚܵܐ ܕܒܲܗܪܵܐ:"
        },
        {
            "verseNumberEn": "15",
            "verseNumberAs": "ܝܗ",
            "verseText": "ܘܠܡܲܕܒ̇ܚܵܐ ܕܒܸܣܡܵܐ: ܘܠܕܝܼܘܲܢܝܵܬ̈ܘܼܗܝ: ܘܠܡܸܫܚܵܐ ܕܡܫܵܚܬܵܐ: ܘܠܒܸܣܡܵܐ ܪܹܝܚܵܢܵܐ: ܘܠܦܲܪܕܵܐ ܕܬܲܪܥܵܐ ܩܵܐ ܬܲܪܥܵܐ ܕܡܵܫܸܟ̇ܢܵܐ:"
        },
        {
            "verseNumberEn": "16",
            "verseNumberAs": "ܝܘ",
            "verseText": "ܠܡܲܕܒ̇ܚܵܐ ܕܕܸܒ̣ܚܵܐ ܡܘܼܩܕܵܐ: ܘܠܩܲܪܩܸܠ ܕܢܚܵܫܵܐ ܕܐܝܼܬ ܠܹܗ: ܠܕܝܼܘܲܢܝܵܬ̈ܘܼܗܝ: ܘܠܟ̇ܠܵܝ ܡܵܐܢܘܼ̈ܗܝ: ܠܠܲܩܢܵܐ ܘܠܟܲܢܘܼܗ̇:"
        },
        {
            "verseNumberEn": "17",
            "verseNumberAs": "ܝܙ",
            "verseText": "ܠܦܲܪ̈ܕܹܐ ܕܕܵܪܬܵܐ: ܠܣܛܘܼܢܘܼ̈ܗ̇: ܘܠܣܵܡܟܘܼ̈ܗ̇: ܘܠܣܸܬܪܵܐ ܕܬܲܪܥܵܐ ܕܕܵܪܬܵܐ:"
        },
        {
            "verseNumberEn": "18",
            "verseNumberAs": "ܝܚ",
            "verseText": "ܠܣܸܟܵܟܹ̈ܐ ܕܡܵܫܸܟ̇ܢܵܐ: ܘܠܣܸܟܵܟܹ̈ܐ ܕܕܵܪܬܵܐ: ܘܠܬܵܢܵܦܵܝ̈:"
        },
