{
    "chapterEn": "Chapter 9",
    "chapterAs": "ܩܦܠܐܘܢ: ܛ.",
    "verses": [
        {
            "verseNumberEn": "1",
            "verseNumberAs": "ܐ",
            "verseText": "ܘܐܣܸܩܠܹܐ ܠܓܵܡܝܼ: ܘܥܒܸܪܹܐ ܘܐܬܹܠܹܐ ܠܡܕܝܼܢ݇ܬܹܗ.",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "2",
            "verseNumberAs": "ܒ",
            "verseText": "ܘܗܵܐ: ܡܘܼܬ݇ܝܹܠܘܿܢ ܠܟܸܣܠܹܗ ܚܵܕ݇ ܫܦܝܼܠܵܐ: ܕܸܪܝܵܐ ܒܫܘܝܼܬܵܐ. ܘܚܙܹܠܹܐ ܝܼܫܘܿܥ ܗܲܝܡܵܢܘܼܬܵܝ: ܘܐܡܸܪܹܐ ܠܗ̇ܘ ܫܦܝܼܠܵܐ: <red>ܦܘܼܫ ܠܸܒܵܢܵܐ: ܒܪܘܼܢܝܼ: ܫܒ̣ܝܼܩܹܐ ܝܢܵܐ ܐܸܠܘܼܟ ܚܛܝܼܵܬܘܼ̈ܟ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "3",
            "verseNumberAs": "ܓ",
            "verseText": "ܘܗܵܐ: ܐܢܵܫܹ̈ܐ ܡ̣ܢ ܣܵܦܪܹ̈ܐ ܐܡܸܪܘܿܢ ܒܓܵܢܵܝ: ܐܵܗܵܐ ܒܸـܓܕܵܦܵܐ ܝܠܹܐ.",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "4",
            "verseNumberAs": "ܕ",
            "verseText": "ܘܝܼܫܘܿܥ ܝܕܸܥܠܹܐ ܚܘܼܫܵܒ̣ܵܝ̈: ܘܐܡܸܪܹܐ ܐܸܠܵܝ: <red>ܩܵܡܘܿܕܝܼ ܒܸܚܫܵܒ̣ܵܐ ܝܬܘܿܢ ܒܝܼܫܬܵܐ ܒܠܸܒܵܘܟ̣ܘܿܢ:</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "5",
            "verseNumberAs": "ܗ",
            "verseText": "<red>ܣܵܒܵܒ̇ ܐܲܝܢܝܼ ܗܵܣܵܢܵܝܝܼ ܝܠܵܐ ܠܹܐܡܵܪܵܐ: ܕܫܒ̣ܝܼܩܹܐ ܝܢܵܐ ܐܸܠܘܼܟ ܚܛܝܼܵܬܘܼ̈ܟ: ܝܲܢ ܠܹܐܡܵܪܵܐ: ܩܘܼܡ݇ ܚܕܘܿܪ:</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "6",
            "verseNumberAs": "ܘ",
            "verseText": "<red>ܐܝܼܢܵܐ ܕܝܲܕܥܝܼܬܘܿܢ ܕܐܝܼܬ ܗܘܼܟܡܵܐ ܠܒܪܘܼܢܹܗ ܕܐܢܵܫܵܐ ܒܐܲܪܥܵܐ ܠܸܫܒ̣ܵܩܵܐ ܚܛܝܼܵܬܹ̈ܐ:</red> ܗ̇ܝܓܵܗ ܐܡܸܪܹܐ ܠܫܦܝܼܠܵܐ: <red>ܩܘܼܡ݇: ܫܩܘܿܠ ܫܘܝܼܬܘܼܟ ܘܙܹܠ݇ܐ ܠܒܲܝܬܘܼܟ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "7",
            "verseNumberAs": "ܙ",
            "verseText": "ܘܩܸܡܠܹܐ ܐܙܸܠܹܐ ܠܒܲܝܬܹܗ.",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "8",
            "verseNumberAs": "ܚ",
            "verseText": "ܐܝܼܢܵܐ ܟܲܕ ܚܙܹܠܘܿܢ ܐܵܢܝܼ ܟܸܢܫܹ̈ܐ: ܙܕܸܥܠܘܿܢ: ܘܫܘܼܒܸܚܠܘܿܢ ܠܐܲܠܵܗܵܐ ܕܝܸܗܒܸܠܹܐ ܐܲܝܟ ܕܐܵܗܵܐ ܗܘܼܟܡܵܐ ܠܒܢܲܝ̈ܢܵܫܵܐ.",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "9",
            "verseNumberAs": "ܛ",
            "verseText": "ܘܟܲܕ ܥܒܸܪܹܐ ܝܼܫܘܿܥ ܡ̣ܢ ܬܵܡܵܐ: ܚܙܹܠܹܐ ܐܢܵܫܵܐ ܝܬܝܼܒ̣ܵܐ ܒܕܘܼܟܵܐ ܕܕܲܡܓ̣ܵܟ̰ܝ̣ܹ̈ܐ: ܫܸܡܹܗ ܡܲܬܲܝ: ܘܐܡܸܪܹܐ ܐܸܠܹܗ: <red>ܬܵܐ ܒܵܬ݇ܪܝܼ.</red> ܘܩܸܡܠܹܐ ܐܙܸܠܹܐ ܒܵܬ݇ܪܹܗ.",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "10",
            "verseNumberAs": "ܝ",
            "verseText": "ܘܗ݇ܘܹܠܵܐ ܕܟܲܕ ܝܬܝܼܒ̣ܵܐ ܗ݇ܘܵܐ ܠܨܘܼܦܪܵܐ ܒܒܲܝܬܵܐ: ܗܵܐ: ܐܬܹܠܘܿܢ ܕܲܡܓ̣ܵܟ̰ܝ̣ܹ̈ܐ ܘܚܲܛܵܝܹ̈ܐ ܪܵܒܵܐ: ܝܬܸܒ̣ܠܘܿܢ ܠܨܘܼܦܪܵܐ ܥܲܡ ܝܼܫܘܿܥ ܘܥܲܡ ܬܲܠܡܝܼܕܘܼ̈ܗܝ.",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "11",
            "verseNumberAs": "ܝܐ",
            "verseText": "ܘܟܲܕ ܚܙܹܠܘܿܢ ܦܪ̈ܝܼܫܹܐ: ܐܵܡܪܝܼ ܠܬܲܠܡܝܼܕܘܼ̈ܗܝ: ܩܵܡܘܼܕܝܼ ܥܲܡ ܕܲܡܓ̣ܵܟ̰ܝ̣ܹ̈ܐ ܘܚܲܛܵܝܹ̈ܐ ܒܹܐܟ̣ܵܠܵܐ ܝܠܹܐ ܪܵܒܝܼܵܘܟ̣ܘܿܢ:",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "12",
            "verseNumberAs": "ܝܒ",
            "verseText": "ܘܝܼܫܘܿܥ ܟܲܕ ܫܡܸܥܠܹܐ ܐܡܸܪܹܐ ܐܸܠܵܝ: <red>ܠܹܐ ܝܢܵܐ ܣܢܝܼܩܹܐ ܐܵܢܝܼ ܕܝܼܢܵܐ ܨܵܚ ܥܲܠ ܗܲܟܝܼܡ: ܐܸܠܵܐ ܐܵܢܝܼ ܕܡܸܪܥܝܹܐ ܝܢܵܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "13",
            "verseNumberAs": "ܝܓ",
            "verseText": "<red>ܙܹܠ݇ܡܘܿܢ ܝܠܘܿܦܘܿܢ ܡܘܼܕܝܼ ܝܠܹܐ: ܪ̈ܲܚܡܹܐ ܟܹܐ ܒܲܥܝܸܢ ܘܠܵܐ ܕܸܒ̣ܚܬܵܐ: ܣܵܒܵܒ̇ ܕܠܵܐ ܐܬܹܠܝܼ ܕܩܵܪܸ‍ܢ ܠܙܲܕܝܼܩܹ̈ܐ: ܐܸܠܵܐ ܠܚܲܛܵܝܹ̈ܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "14",
            "verseNumberAs": "ܝܕ",
            "verseText": "ܗ̇ܝܓܵܗ ܐܬܹܠܘܿܢ ܠܟܸܣܠܹܗ ܬܲܠܡܝܼܕܹ̈ܐ ܕܝܘܿܚܲܢܵܢ: ܒܹܐܡܵܪܵܐ: ܩܵܡܘܿܕܝܼ ܐܲܚܢܲܢ ܘܦܪ̈ܝܼܫܹܐ ܟܹܐ ܨܵܝܡܵܚ ܪܵܒܵܐ: ܘܬܲܠܡܝܼܕܘܼ̈ܟ ܠܹܐ ܨܵܝܡܝܼ:",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "15",
            "verseNumberAs": "ܝܗ",
            "verseText": "ܐܵܡܸܪ ܐܸܠܵܝ ܝܼܫܘܿܥ: <red>ܟܹܐ ܡܵܨܝܼ ܒܢܘܼܢܹ̈ܐ ܕܓܢܘܿܢܵܐ ܠܸܨܝܵܡܵܐ ܟܡܵܐ ܕܚܸܬܢܵܐ ܥܲܡܵܝ: ܐܝܼܢܵܐ ܒܹܐܬܵܝܵܐ ܝܢܵܐ ܝܘܿܡܵܢܹ̈ܐ: ܟܲܕ ܦܵܝܸܫ ܫܩܝܼܠܵܐ ܡܸܢܵܝ ܚܸܬܢܵܐ: ܘܗ̇ܝܓܵܗ ܒܸܬ ܨܵܝܡܝܼ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "16",
            "verseNumberAs": "ܝܘ",
            "verseText": "<red>ܐܢܵܫܵܐ ܠܹܐ ܕܵܪܹܐ ܥܵܪܵܝܬܵܐ ܚܲܕܬܵܐ ܥܲܠ ܓ̰ܘܼܠܵܐ ܒܸܠܝܵܐ: ܣܵܒܵܒ̇ ܕܟܹܐ ܓܵܪܫܵܐ ܡܸܠܝܘܼܬܘܼܗ̇ ܡܗ̇ܘ ܓ̰ܘܼܠܵܐ: ܘܟܹܐ ܗܵܘܹܐ ܦܸܪܛܵܐ ܙܵܘܕܵܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "17",
            "verseNumberAs": "ܝܙ",
            "verseText": "<red>ܘܠܹܐ ܕܵܪܝܼ ܚܲܡܪܵܐ ܚܵܕ݇ܬܵܐ ܒܓܘܼܕܹ̈ܐ ܒܸܠܝܹ̈ܐ: ܘܐܸ‍ܢ ܠܵܐ: ܟܹܐ ܦܵܝܫܝܼ ܟ̰ܘܼܢܟ̰ܸܪܹܐ ܓܘܼܕܹ̈ܐ: ܘܚܲܡܪܵܐ ܬܵܦܸܟ: ܘܓܘܼܕܹ̈ܐ ܟܹܐ ܬܵܠܩܝܼ. ܐܸܠܵܐ ܚܲܡܪܵܐ ܚܵܕ݇ܬܵܐ ܟܹܐ ܕܵܪܝܼ ܒܓܘܼܕܹ̈ܐ ܚܵܕ݇ܬܹ̈ܐ: ܘܬܸܪܘܵܝ ܟܹܐ ܦܵܝܫܝܼ ܢܛܬܝܼܪܹܐ:</red>",
            "isRedLetter": false,
            "verseNote": "ܟ̰ܘܼܢܟ̰ܸܪܹܐ: ܝܲܢ ܨܸܪܝܹܐ\nܬܵܦܸܟ: ܝܲܢ ܡܒܵܕܸܪ"
        },
        {
            "verseNumberEn": "18",
            "verseNumberAs": "ܝܚ",
            "verseText": "ܘܟܲܕ ܐܲܢܹܐ ܗܲܡܙܘܼܡܹܐ ܗ݇ܘܵܐ ܥܲܡܵܝ: ܗܵܐ: ܐܬܹܠܹܐ ܚܵܕ݇ ܐܲܪܟܘܿܢܵܐ ܣܓܸܕܠܹܐ ܐܸܠܹܗ: ܘܐܡܸܪܹܐ: ܒܪܵܬܝܼ ܐܵܕܝܼܵܐ ܡܸܬܠܵܐ: ܐܸܠܵܐ ܬܵܐ ܡܲܬܸܒ̣ ܐܝܼܕܘܼܟ ܥܲܠܘܼܗ̇ ܘܒܸܬ ܚܲܝܵܐ.",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "19",
            "verseNumberAs": "ܝܛ",
            "verseText": "ܘܩܸܡܠܹܐ ܝܼܫܘܿܥ ܘܬܲܠܡܝܼܕܘܼ̈ܗܝ ܘܐܙܸܠܘܿܢ ܒܵܬ݇ܪܹܗ.",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "20",
            "verseNumberAs": "ܟ",
            "verseText": "ܘܗܵܐ: ܚܕܵܐ ܒܲܟ̣ܬܵܐ ܕܒܹܐܙܵܠܵܐ ܗ݇ܘܵܐ ܕܸܡܘܼܗ̇ ܬܪܸܥܣܲܪ ܫܸܢܹ̈ܐ: ܐܬܹܠܵܐ ܡ̣ܢ ܒܵܬ݇ܪܹܗ: ܘܕܩܸܪܵܐ ܒܫܸܦܘܼܠܵܐ ܕܠܒܸܫܬܹܗ.",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "21",
            "verseNumberAs": "ܟܐ",
            "verseText": "ܣܵܒܵܒ̇ ܕܐܡܸܪܵܐ ܓܵܘ ܓܵܢܘܼܗ̇: ܐܵܦܸܢ ܕܗܲܪ ܒܓ̰ܘܼܠܹܗ ܕܵܩܪܵܢ: ܒܸܬ ܒܵܣܡܵܢ.",
            "isRedLetter": false,
            "verseNote": ""
