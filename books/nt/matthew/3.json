{
    "chapterEn": "Chapter 3",
    "chapterAs": "ܩܦܠܐܘܢ: ܓ.",
    "verses": [
        {
            "verseNumberEn": "1",
            "verseNumberAs": "ܐ",
            "verseText": "ܘܒܵܐܢܝܼ ܝܘܿܡܵܢܹ̈ܐ ܐܬܹܠܹܐ ܝܘܿܚܲܢܵܢ ܡܲܥ݇ܡܕܵܢܵܐ: ܡܲܟܪܘܼܙܹܐ ܓܵܘ ܒܲܪܝܼܵܐ ܕܝܼܗܘܼܕ:",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "2",
            "verseNumberAs": "ܒ",
            "verseText": "ܒܹܐܡܵܪܵܐ: ܬܲܘܸܒܘܿܢ: ܣܵܒܵܒ̇ ܩܘܼܪܒܸܢܵܐ ܡܲܠܟܘܼܬܵܐ ܕܫܡܲܝܵܐ.",
            "isRedLetter": false,
            "verseNote": "ܩܘܼܪܒܸܢܵܐ: ܝܢ ܩܪܸܒ̣ܠܵܐ"
        },
        {
            "verseNumberEn": "3",
            "verseNumberAs": "ܓ",
            "verseText": "ܣܵܒܵܒ̇ ܐܵܗܵܐ ܝܠܹܐ ܗ̇ܘ ܕܝܼܠܹܐ ܐܡܝܼܪܵܐ ܒܝ̣ܸܕ ܐܹܫܲܥܝܵܐ ܢܒ̣ܝܼܵܐ: ܕܐܡܸܪܹܐ: ܩܵܠܵܐ ܕܩܵܪܹܐ ܓܵܘ ܒܲܪܝܼܵܐ: ܗܵܕܪܘܿܢ ܐܘܼܪܚܹܗ ܕܡܵܪܝܵܐ: ܘܡܲܫܘܹܡܘܿܢ ܠܓ̰ܵܕܵܘܵܬܘܼ̈ܗܝ.",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "4",
            "verseNumberAs": "ܕ",
            "verseText": "ܘܗ̇ܘ ܝܘܿܚܲܢܵܢ ܐܝܼܬ ܗ݇ܘܵܐ ܠܹܗ ܠܒܸܫܬܵܐ ܕܣܲܥܪܵܐ ܕܓܘܼܡܠܹ̈ܐ: ܘܚܵܨܵܐ ܕܓܸܠܕܵܐ ܒܚܵܨܹܗ: ܘܡܹܐܟ̣ܘܼܠܬܹܗ ܩܲܡܨܹ̈ܐ ܘܕܸܒ̣ܫܵܐ ܕܒܲܪܝܼܵܐ.",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "5",
            "verseNumberAs": "ܗ",
            "verseText": "ܗ̇ܝܓܵܗ ܦܠܸܛܠܵܐ ܠܟܸܣܠܹܗ ܐܘܿܪܸܫܠܸܡ ܘܟܠܵܗ̇ ܝܼܗܘܼܕ: ܘܟܠܹܗ ܐܲܬܪܵܐ ܕܠܚܵܕܸܪ̈ܘܵܢܹܐ ܕܝܘܿܪܕܢܵܢ:",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "6",
            "verseNumberAs": "ܘ",
            "verseText": "ܘܥܡܸܕܠܘܿܢ ܡܸܢܹܗ ܒܝܘܿܪܕܢܵܢ ܢܲܗܪܵܐ: ܟܲܕ ܡܵܘܕܘܿܝܹܐ ܒܚܛܝܼܵܬܵܝ̈.",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "7",
            "verseNumberAs": "ܙ",
            "verseText": "ܐܝܼܢܵܐ ܟܲܕ ܚܙܹܠܹܐ ܪܵܒܵܐ ܡ̣ܢ ܦܪ̈ܝܼܫܹܐ ܘܡ̣ܢ ܙܲܕܘܼܩܵܝܹ̈ܐ ܒܹܐܬܵܝܵܐ ܠܡܲܥܡܘܿܕܝܼܬܹܗ: ܐܡܸܪܹܐ ܐܸܠܵܝ: ܙܲܪܥܵܐ ܕܐܵܟܸܕܢܹ̈ܐ: ܡܵܢܝܼ ܡܘܼܕܸܥܠܹܐ ܐܸܠܵܘܟ̣ܘܿܢ ܠܸܥܪܵܩܵܐ ܡ̣ܢ ܟܲܪܒܵܐ ܕܒܹܐܬܵܝܵܐ ܝܠܵܐ:",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "8",
            "verseNumberAs": "ܚ",
            "verseText": "ܥܒ̣ܘܿܕܘܿܢ ܗܲܕܟ̣ܵܐ ܛܥܘܼܢܝܵܬܹ̈ܐ ܕܚܵܫܚܝܼ ܠܬܝܵܒ̣ܘܼܬܵܐ:",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "9",
            "verseNumberAs": "ܛ",
            "verseText": "ܘܠܵܐ ܚܵܫܒ̣ܝܼܬܘܿܢ ܘܐܵܡܪܝܼܬܘܿܢ ܒܓܵܢܵܘܟ̣ܘܿܢ: ܒܵܒܵܐ ܐܝܼܬ ܠܲܢ: ܐܲܒ̣ܪܵܗܵܡ: ܣܵܒܵܒ̇ ܒܹܐܡܵܪܵܐ ܝܘܸ‍ܢ ܐܸܠܵܘܟ̣ܘܿܢ: ܕܡܵܨܹܐ ܐܲܠܵܗܵܐ ܡܐܲܢܹܐ ܟܹܐܦܹ̈ܐ ܠܡܲܩܘܼܡܹܐ ܒܢܘܼܢܹ̈ܐ ܠܐܲܒ̣ܪܵܗܵܡ.",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
