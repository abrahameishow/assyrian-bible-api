{
    "chapterEn": "Chapter 8",
    "chapterAs": "ܩܦܠܐܘܢ: ܚ.",
    "verses": [
        {
            "verseNumberEn": "1",
            "verseNumberAs": "ܐ",
            "verseText": "ܘܟܲܕ ܨܠܹܠܹܐ ܡ̣ܢ ܛܘܼܪܵܐ: ܬܒܸܥܠܘܿܢ ܐܸܠܹܗ ܟܸܢܫܹ̈ܐ ܪܵܒܵܐ.",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "2",
            "verseNumberAs": "ܒ",
            "verseText": "ܘܗܵܐ: ܚܵܕ݇ ܓܸܪܒ̣ܵܢܵܐ ܐܬܹܠܹܐ ܣܓܸܕܠܹܐ ܐܸܠܹܗ: ܘܐܡܸܪܹܐ: ܡܵܪܝܼ: ܐܸ‍ܢ ܒܲܥܝܸܬ: ܟܹܐ ܡܵܨܸܬ ܠܕܵܟ̣ܘܿܝܝܼ.",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "3",
            "verseNumberAs": "ܓ",
            "verseText": "ܘܝܼܫܘܿܥ ܦܘܼܫܛܵܠܹܐ ܐܝܼܕܹܗ ܕܩܸܪܹܐ ܒܝ̣ܹܗ: ܘܐܡܸܪܹܐ: <red>ܒܸܒܲܥܝܵܐ ܝܘܸ‍ܢ: ܦܘܼܫ ܕܸܟ̣ܝܵܐ.</red> ܘܕܲܪܣܵܥܲܬ ܕܟܹܠܹܐ ܓܸܪܒܹܗ.",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "4",
            "verseNumberAs": "ܕ",
            "verseText": "ܘܐܡܸܪܹܐ ܐܸܠܹܗ ܝܼܫܘܿܥ: <red>ܚܙܝܼ: ܕܠܐܢܵܫܵܐ ܠܵܐ ܐܵܡܪܸܬ: ܐܸܠܵܐ ܙܹܠ݇ܐ ܡܲܚܙܝܼ ܓܵܢܘܼܟ ܠܟܵܗܢܵܐ: ܘܡܲܩܪܸܒ̣ ܩܘܼܪܒܵܢܵܐ ܕܦܩܸܕܠܹܐ ܡܘܼܫܹܐ ܠܣܵܗܕܘܼܬܵܝ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "5",
            "verseNumberAs": "ܗ",
            "verseText": "ܘܟܲܕ ܐܘܸܪܹܐ ܝܼܫܘܿܥ ܠܟܦܲܪܢܵܚܘܿܡ: ܐܬܹܠܹܐ ܠܟܸܣܠܹܗ ܚܵܕ݇ ܩܸܢܛܪܘܿܢܵܐ: ܘܦܲܪܦܸܠ ܗ݇ܘܵܐ ܒܝ̣ܹܗ:",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "6",
            "verseNumberAs": "ܘ",
            "verseText": "ܘܐܵܡܸܪ: ܡܵܪܝܼ: ܝܵܠܝܼ ܕܸܪܝܵܐ ܝܠܹܐ ܒܒܲܝܬܵܐ: ܫܦܝܼܠܵܐ: ܘܣܸܪܝܵܐ ܦܝܵܫܵܐ ܓ̰ܘܼܢܓ̰ܸܪܵܐ.",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "7",
            "verseNumberAs": "ܙ",
            "verseText": "ܐܵܡܸܪ ܐܸܠܹܗ ܝܼܫܘܿܥ: <red>ܐܵܢܵܐ ܒܸܬ ܐܵܬܸ‍ܢ ܘܒܸܬ ܒܵܣܡܸܢܹܗ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "8",
            "verseNumberAs": "ܚ",
            "verseText": "ܓ̰ܘܼܘܸܒܠܹܐ ܩܸܢܛܪܘܿܢܵܐ ܘܐܡܸܪܹܐ: ܡܵܪܝܼ: ܠܹܐ ܚܵܫܚܸܢ ܕܐܵܘܪܸܬ ܬܚܘܿܬ ܫܟܘܼܪܝܼ: ܐܸܠܵܐ ܗܲܪ ܐܡܘܿܪ ܒܗܹܡܸܙܡܵܢ: ܘܒܸܬ ܒܵܣܸܡ ܝܵܠܝܼ.",
            "isRedLetter": false,
            "verseNote": "ܝܵܠܝܼ: ܝܲܢ ܪܹܓܝܼ"
        },
        {
            "verseNumberEn": "9",
            "verseNumberAs": "ܛ",
            "verseText": "ܣܵܒܵܒ̇ ܐܘܼܦ ܐܵܢܵܐ ܐܢܵܫܵܐ ܝܘܸ‍ܢ ܬܚܘܿܬ ܗܘܼܟܡܵܐ: ܘܐܝܼܬ ܬܚܘܿܬ ܐܝܼܕܝܼ̈ ܣܲܪ̈ܒܵܙܹܐ: ܘܟܹܐ ܐܵܡܪܸ‍ܢ ܠܐܵܗܵܐ: ܙܹܠ݇ܐ: ܘܟܹܐ ܐܵܙܸܠ: ܘܠܗ̇ܘ ܐܚܹܪ݇ܢܵܐ: ܬܵܐ: ܘܟܹܐ ܐܵܬܹܐ: ܘܠܪܹܓܝܼ: ܥܒ̣ܘܿܕ ܐܵܗܵܐ: ܘܟܹܐ ܥܵܒܸܕ.",
            "isRedLetter": false,
            "verseNote": ""
        },
