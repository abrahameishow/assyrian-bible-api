{
    "chapterEn": "Chapter 5",
    "chapterAs": "ܩܦܠܐܘܢ: ܗ.",
    "verses": [
        {
            "verseNumberEn": "1",
            "verseNumberAs": "ܐ",
            "verseText": "ܘܟܲܕ ܚܙܹܠܹܐ ܠܟܸܢܫܹ̈ܐ: ܐܣܸܩܠܹܐ ܠܛܘܼܪܵܐ: ܘܟܲܕ ܝܬܸܒ̣ܠܹܐ: ܐܬܹܠܘܿܢ ܠܟܸܣܠܹܗ ܬܲܠܡܝܼܕܘܼ̈ܗܝ.",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "2",
            "verseNumberAs": "ܒ",
            "verseText": "ܘܦܬܸܚܠܹܐ ܦܘܼܡܹܗ: ܘܡܵܠܸܦ ܗ݇ܘܵܐ ܠܗ݇ܘܿܢ: ܘܐܵܡܸܪ:",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "3",
            "verseNumberAs": "ܓ",
            "verseText": "<red>ܛܘܼܒ̣ܵܐ ܠܡܸܣܟܹܢܹ̈ܐ ܒܪܘܼܚܵܐ: ܣܵܒܵܒ̇ ܕܕܝܼܵܝ ܝܠܵܐ ܡܲܠܟܘܼܬܵܐ ܕܫܡܲܝܵܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "4",
            "verseNumberAs": "ܕ",
            "verseText": "<red>ܛܘܼܒ̣ܵܐ ܠܥܵܒ̣ܕܵܢܹ̈ܐ ܕܬܵܙܝܼ: ܣܵܒܵܒ̇ ܕܐܵܢܝܼ ܒܸܬ ܦܵܝܫܝܼ ܝܘܼܗ݇ܒܹܐ ܠܸܒܵܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "5",
            "verseNumberAs": "ܗ",
            "verseText": "<red>ܛܘܼܒ̣ܵܐ ܠܡܵܟܝܼܟܹ̈ܐ: ܣܵܒܵܒ̇ ܕܐܵܢܝܼ ܒܸܬ ܝܵܪܬܝܼ ܐܲܪܥܵܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "6",
            "verseNumberAs": "ܘ",
            "verseText": "<red>ܛܘܼܒ̣ܵܐ ܠܐܵܢܝܼ ܕܟܵܦܢܝܼ ܘܨܲܗ݇ܝܝܼ ܠܟܹܐܢܘܼܬܵܐ: ܣܵܒܵܒ̇ ܕܐܵܢܝܼ ܒܸܬ ܣܲܒ̣ܥܝܼ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "7",
            "verseNumberAs": "ܙ",
            "verseText": "<red>ܛܘܼܒ̣ܵܐ ܠܡܪܲ̈ܚܡܵܢܹܐ: ܣܵܒܵܒ̇ ܕܥܲܠܵܝ ܒܸܬ ܗܵܘܝܼ ܪ̈ܲܚܡܹܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "8",
            "verseNumberAs": "ܚ",
            "verseText": "<red>ܛܘܼܒ̣ܵܐ ܠܐܵܢܝܼ ܕܝܼܢܵܐ ܕܸܟ̣ܝܹ̈ܐ ܒܠܸܒܵܐ: ܣܵܒܵܒ̇ ܕܐܵܢܝܼ ܒܸܬ ܚܵܙܝܼ ܠܐܲܠܵܗܵܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "9",
            "verseNumberAs": "ܛ",
            "verseText": "<red>ܛܘܼܒ̣ܵܐ ܠܥܵܒ̣ܕܵܢܹ̈ܐ ܕܫܠܵܡܵܐ: ܣܵܒܵܒ̇ ܕܒܢܘܼܢܹ̈ܐ ܕܐܲܠܵܗܵܐ ܒܸܬ ܦܵܝܫܝܼ ܩܸܪܝܹܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "10",
            "verseNumberAs": "ܝ",
            "verseText": "<red>ܛܘܼܒ̣ܵܐ ܠܐܵܢܝܼ ܕܦܸܫܠܘܿܢ ܛܪܝܼܕܹܐ ܣܵܒܵܒ̇ ܕܟܹܐܢܘܼܬܵܐ: ܣܵܒܵܒ̇ ܕܕܝܼܵܝ ܝܠܵܐ ܡܲܠܟܘܼܬܵܐ ܕܫܡܲܝܵܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "11",
            "verseNumberAs": "ܝܐ",
            "verseText": "<red>ܛܘܼܒ̣ܵܐ ܐܸܠܵܘܟ̣ܘܿܢ ܐܝܼܡܲܢ ܕܠܵܝܡܝܼ ܠܵܘܟ̣ܘܿܢ: ܘܛܵܪܕܝܼ ܠܵܘܟ̣ܘܿܢ: ܘܐܵܡܪܝܼ ܥܲܠܵܘܟ̣ܘܿܢ ܟܠ ܗܹܡܸܙܡܵܢ ܒܝܼܫܬܵܐ ܣܵܒܵܒ̇ ܕܝܼܝܼ ܒܕܵܓܵܠܘܼܬܵܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "12",
            "verseNumberAs": "ܝܒ",
            "verseText": "<red>ܚܕܹܡܘܿܢ ܘܦܨܘܿܚܘܿܢ: ܕܗܵܩܵܘܟ̣ܘܿܢ ܪܵܒܵܐ ܝܠܹܐ ܒܫܡܲܝܵܐ: ܣܵܒܵܒ̇ ܗܲܕܟ̣ܵܐ ܛܪܸܕܠܘܿܢ ܠܢܒ̣̈ܝ̣ܹܐ ܕܡ̣ܢ ܩܵܕ݇ܡܵܘܟ̣ܘܿܢ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "13",
            "verseNumberAs": "ܝܓ",
            "verseText": "<red>ܐܲܚܬܘܿܢ ܝܼܬܘܿܢ ܡܸܠܚܵܐ ܕܐܲܪܥܵܐ: ܐܝܼܢܵܐ ܐܸ‍ܢ ܡܸܠܚܵܐ ܦܵܝܟܵܐ: ܒܡܘܼܕܝܼ ܒܸܬ ܦܵܝܫܵܐ ܡܘܼܡܠܸܚܬܵܐ: ܠܡܸܢܕܝܼ ܦܲܝܕܵܐ ܠܹܐ ܗܵܘܝܵܐ: ܐܸܠܵܐ ܕܦܵܝܫܵܐ ܪܘܼܦܝܼܬܵܐ ܠܒܲܕܲܪ ܘܕܝܼܫܬܵܐ ܡ̣ܢ ܐ݇ܢܵܫܹ̈ܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "14",
            "verseNumberAs": "ܝܕ",
            "verseText": "<red>ܐܲܚܬܘܿܢ ܝܼܬܘܿܢ ܒܲܗܪܹܗ ܕܥܵܠܡܵܐ. ܠܹܐ ܡܵܨܝܵܐ ܕܛܵܫܝܵܐ ܡܕܝܼܢ݇ܬܵܐ ܕܥܲܠ ܛܘܼܪܵܐ ܒܢܝܼܬܵܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "15",
            "verseNumberAs": "ܝܗ",
            "verseText": "<red>ܘܠܹܐ ܬܵܦܝܼ ܫܪܵܝܵܐ ܘܡܲܬܒ̣ܝܼ ܠܵܗ̇ ܬܚܘܿܬ ܣܲܐܬܵܐ: ܐܸܠܵܐ ܥܲܠ ܟ̰ܪܲܚܦܝܼ: ܘܟܹܐ ܝܵܗ݇ܒ̣ܵܐ ܒܲܗܪܵܐ ܠܟ̇ܠܵܝ ܐܵܢܝܼ ܕܒܒܲܝܬܵܐ ܝܢܵܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "16",
            "verseNumberAs": "ܝܘ",
            "verseText": "<red>ܗܲܕܟ̣ܵܐ ܒܲܗ݇ܪܸ‍ܢ ܒܲܗܪܵܘܟ̣ܘܿܢ ܩܵܕ݇ܡ ܒܢܲܝ̈ܢܵܫܵܐ: ܕܚܵܙܝܼ ܦܘܼܠܚܵܢܵܘ̈ܟ̣ܘܿܢ ܛܵܒܹ̈ܐ: ܘܫܵܒܚܝܼ ܠܒܵܒܵܘܟ̣ܘܿܢ ܕܒܫܡܲܝܵܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "17",
            "verseNumberAs": "ܝܙ",
            "verseText": "<red>ܠܵܐ ܚܵܫܒ̣ܝܼܬܘܿܢ ܕܐܬܹܠܝܼ ܕܫܵܪܸ‍ܢ ܢܵܡܘܿܣܵܐ ܝܲܢ ܢܒ̣̈ܝ̣ܹܐ. ܠܵܐ ܐܬܹܠܝܼ ܕܫܵܪܸ‍ܢ ܐܸܠܵܐ ܕܬܲܡܸܡܸܢ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "18",
            "verseNumberAs": "ܝܚ",
            "verseText": "<red>ܣܵܒܵܒ̇ ܬܪܘܼܨܵܐ ܒܹܐܡܵܪܵܐ ܝܘܸ‍ܢ ܐܸܠܵܘܟ̣ܘܿܢ: ܕܗܲܠ ܕܥܵܒ̣ܪܝܼ ܫܡܲܝܵܐ ܘܐܲܪܥܵܐ: ܚܕܵܐ ܝܘܿܕ ܝܲܢ ܚܵܕ݇ ܣܸܪܛܵܐ ܠܹܐ ܥܵܒܸܪ ܡ̣ܢ ܢܵܡܘܿܣܵܐ ܗܲܠ ܕܟܠ ܗܵܘܹܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "19",
            "verseNumberAs": "ܝܛ",
            "verseText": "<red>ܟܠ ܡ̇ܢ ܕܫܵܪܹܐ ܗܲܕܟ̣ܵܐ ܚܵܕ݇ ܡ̣ܢ ܕܐܲܢܹܐ ܦܘܼܩܕܵܢܹ̈ܐ ܒܘܼܫ ܙܥܘܿܪܹ̈ܐ: ܘܡܵܠܸܦ ܗܲܕܟ̣ܵܐ ܠܒܢܲܝ̈ܢܵܫܵܐ: ܒܘܼܫ ܙܥܘܿܪܵܐ ܒܸܬ ܦܵܝܸܫ ܩܸܪܝܵܐ ܒܡܲܠܟܘܼܬܵܐ ܕܫܡܲܝܵܐ: ܐܝܼܢܵܐ ܟܠ ܕܥܵܒܸܕ ܘܡܵܠܸܦ: ܐܵܗܵܐ ܓܘܼܪܵܐ ܒܸܬ ܦܵܝܸܫ ܩܸܪܝܵܐ ܒܡܲܠܟܘܼܬܵܐ ܕܫܡܲܝܵܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "20",
            "verseNumberAs": "ܟ",
            "verseText": "<red>ܣܵܒܵܒ̇ ܕܒܹܐܡܵܪܵܐ ܝܘܸ‍ܢ ܐܸܠܵܘܟ̣ܘܿܢ: ܕܐܸ‍ܢ ܠܵܐ ܙܵܝܕܵܐ ܟܹܐܢܘܼܬܵܘܟ̣ܘܿܢ ܙܵܘܕܵܐ ܡ̣ܢ ܕܣܵܦܪܹ̈ܐ ܘܦܪ̈ܝܼܫܹܐ: ܠܹܐ ܐܵܘܪܝܼܬܘܿܢ ܠܡܲܠܟܘܼܬܵܐ ܕܫܡܲܝܵܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "21",
            "verseNumberAs": "ܟܐ",
            "verseText": "<red>ܫܡܸܥܠܵܘܟ̣ܘܿܢ ܕܦܸܫܠܹܐ ܐܡܝܼܪܵܐ ܠܩܵܕ݇ܡܵܝܹ̈ܐ: ܠܵܐ ܩܵܛܠܸܬ: ܘܟܠ ܕܩܵܛܸܠ: ܓܘܼܢܵܗܟܵܪ ܝܼܠܹܐ ܠܕܝܼܘܵܢ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "22",
            "verseNumberAs": "ܟܒ",
            "verseText": "<red>ܐܝܼܢܵܐ ܐܵܢܵܐ ܒܹܐܡܵܪܵܐ ܝܘܸ‍ܢ ܐܸܠܵܘܟ̣ܘܿܢ: ܕܟܠ ܡ̇ܢ ܕܟܵܪܸܒ̇ ܥܲܠ ܐܵܚܘܿܢܹܗ ܕܠܵܐ ܗܲܓ̰ܼܿܬ: ܓܘܼܢܵܗܟܵܪ ܝܼܠܹܐ ܠܕܝܼܘܵܢ: ܘܟܠ ܕܐܵܡܸܪ ܠܐܵܚܘܿܢܹܗ: ܪܵܩܵܐ: ܓܘܼܢܵܗܟܵܪ ܝܼܠܹܐ ܠܟܸܢܫܵܐ ܕܪܵܐܝܝܼ: ܘܟܠ ܕܐܲܡܸܪ: ܐܲܗܡܲܩ: ܓܘܼܢܵܗܟܵܪ ܝܼܠܹܐ ܠܓܹܗܲܢܵܐ ܕܢܘܼܪܵܐ.</red>",
            "isRedLetter": false,
            "verseNote": "ܕܠܵܐ ܗܲܓ̰ܼܿܬ: ܚܟܡܐ ܐܨܚ̈. ܥܬ̈. ܝܘܢ̈‍. ܠܝܬ-ܕܠܵܐ ܗܲܓ̰ܼܿܬ"
        },
        {
            "verseNumberEn": "23",
            "verseNumberAs": "ܟܓ",
            "verseText": "<red>ܐܸ‍ܢ ܗܲܕܟ̣ܵܐ ܡܲܝܬ݇ܝܸܬ ܩܘܼܪܒܵܢܘܼܟ ܠܡܲܕܒ̇ܚܵܐ: ܘܬܵܡܵܐ ܕܵܟ̣ܪܸܬ ܕܕܒ̣ܝܼܩܵܐ ܝܠܹܐ ܥܲܠܘܼܟ ܐܵܚܘܿܢܘܼܟ ܟܝܼܢ ܡܸܢܕܝܼ:</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
