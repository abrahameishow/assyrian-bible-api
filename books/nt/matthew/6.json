{
    "chapterEn": "Chapter 6",
    "chapterAs": "ܩܦܠܐܘܢ: ܘ.",
    "verses": [
        {
            "verseNumberEn": "1",
            "verseNumberAs": "ܐ",
            "verseText": "<red>ܚܘܼܪܘܿܢ ܒܙܲܕܝܼܩܘܼܬܵܘܟ̣ܘܿܢ: ܕܠܵܐ ܥܵܒ̣ܕܝܼܬܘܿܢ ܠܵܗ̇ ܩܵܕ݇ܡ ܒܢܲܝ̈ܢܵܫܵܐ: ܐܲܝܟ ܕܦܵܝܫܝܼܬܘܿܢ ܚܸܙܝܹܐ ܐܸܠܵܝ: ܘܐܸ‍ܢ ܠܵܐ: ܠܲܝܬ ܠܵܘܟ̣ܘܿܢ ܗܵܩܵܐ ܠܟܸܣ ܒܵܒܵܘܟ̣ܘܿܢ ܕܒܫܡܲܝܵܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "2",
            "verseNumberAs": "ܒ",
            "verseText": "<red>ܐܝܼܡܲܢ ܗܲܕܟ̣ܵܐ ܕܥܵܒ̣ܕܸܬ ܐܸܪܘܵܢܵܐ: ܠܵܐ ܩܵܪܸܬ ܩܵܪ݇ܢܵܐ ܩܵܕ݇ܡܘܼܟ: ܐܲܝܟ ܕܥܵܒ̣ܕܝܼ ܢܵܣܒܲܝ̈ ܒܐܲܦܹ̈ܐ ܒܟܢܘܼܫܝܵܬܹ̈ܐ ܘܒܥܵܠܘܠܹ̈ܐ: ܕܦܵܝܫܝܼ ܚܩܝܼܪܹܐ ܡ̣ܢ ܒܢܲܝ̈ܢܵܫܵܐ. ܬܪܘܼܨܵܐ ܒܹܐܡܵܪܵܐ ܝܘܸ‍ܢ ܐܸܠܵܘܟ̣ܘܿܢ ܕܩܘܼܒܸܠܘܿܢ ܗܵܩܵܝ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "3",
            "verseNumberAs": "ܓ",
            "verseText": "<red>ܐܝܼܢܵܐ ܐܲܢ݇ܬ: ܐܝܼܡܲܢ ܕܥܵܒ̣ܕܸܬ ܐܸܪܘܵܢܵܐ: ܠܵܐ ܝܲܕܥܵܐ ܣܸܡܵܠܘܼܟ ܡܘܼܕܝܼ ܒܸܥܒ̣ܵܕܵܐ ܝܠܵܐ ܝܲܡܝܼܢܘܼܟ:</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "4",
            "verseNumberAs": "ܕ",
            "verseText": "<red>ܕܗܵܘܹܐ ܐܸܪܘܵܢܘܼܟ ܒܛܸܫܘܵܐ: ܘܒܵܒܘܼܟ ܕܚܵܙܹܐ ܒܛܸܫܘܵܐ: ܗ̇ܘ ܒܸܬ ܦܲܪܸܥ ܠܘܼܟ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "5",
            "verseNumberAs": "ܗ",
            "verseText": "<red>ܘܐܝܼܡܲܢ ܕܨܵܠܸܬ ܨܠܘܿܬܵܟ: ܠܵܐ ܗܵܘܸܬ ܐܲܝܟ ܢܵܣܒܲܝ̈ ܒܐܲܦܹ̈ܐ: ܕܡܲܚܸܒܝܼ ܠܸܟܠܵܝܵܐ ܒܟܢܘܼܫܝܵܬܹ̈ܐ ܘܒܩܘܼܢܓ̰ܝܼܵܬܹ̈ܐ ܕܥܵܠܘܠܹ̈ܐ ܠܨܵܠܘܿܝܹܐ: ܕܦܵܝܫܝܼ ܚܸܙܝܹܐ ܠܒܢܲܝ̈ܢܵܫܵܐ. ܬܪܘܼܨܵܐ ܒܹܐܡܵܪܵܐ ܝܘܸ‍ܢ ܐܸܠܵܘܟ̣ܘܿܢ ܕܩܘܼܒܸܠܘܿܢ ܗܵܩܵܝ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
