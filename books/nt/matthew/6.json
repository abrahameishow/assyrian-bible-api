{
    "chapterEn": "Chapter 6",
    "chapterAs": "ܩܦܠܐܘܢ: ܘ.",
    "verses": [
        {
            "verseNumberEn": "1",
            "verseNumberAs": "ܐ",
            "verseText": "<red>ܚܘܼܪܘܿܢ ܒܙܲܕܝܼܩܘܼܬܵܘܟ̣ܘܿܢ: ܕܠܵܐ ܥܵܒ̣ܕܝܼܬܘܿܢ ܠܵܗ̇ ܩܵܕ݇ܡ ܒܢܲܝ̈ܢܵܫܵܐ: ܐܲܝܟ ܕܦܵܝܫܝܼܬܘܿܢ ܚܸܙܝܹܐ ܐܸܠܵܝ: ܘܐܸ‍ܢ ܠܵܐ: ܠܲܝܬ ܠܵܘܟ̣ܘܿܢ ܗܵܩܵܐ ܠܟܸܣ ܒܵܒܵܘܟ̣ܘܿܢ ܕܒܫܡܲܝܵܐ.</red>",
            "isRedLetter": false,
            "verseNote": "ܒܙܲܕܝܼܩܘܼܬܵܘܟ̣ܘܿܢ: ܦܫܝܛ. ܘܚܟܡܐ ܐܨܚ̈. ܝܘܢ̈‍. ܒܐܸܪܘܵܢܵܘܟ̣ܘܿܢ"
        },
        {
            "verseNumberEn": "2",
            "verseNumberAs": "ܒ",
            "verseText": "<red>ܐܝܼܡܲܢ ܗܲܕܟ̣ܵܐ ܕܥܵܒ̣ܕܸܬ ܐܸܪܘܵܢܵܐ: ܠܵܐ ܩܵܪܸܬ ܩܵܪ݇ܢܵܐ ܩܵܕ݇ܡܘܼܟ: ܐܲܝܟ ܕܥܵܒ̣ܕܝܼ ܢܵܣܒܲܝ̈ ܒܐܲܦܹ̈ܐ ܒܟܢܘܼܫܝܵܬܹ̈ܐ ܘܒܥܵܠܘܠܹ̈ܐ: ܕܦܵܝܫܝܼ ܚܩܝܼܪܹܐ ܡ̣ܢ ܒܢܲܝ̈ܢܵܫܵܐ. ܬܪܘܼܨܵܐ ܒܹܐܡܵܪܵܐ ܝܘܸ‍ܢ ܐܸܠܵܘܟ̣ܘܿܢ ܕܩܘܼܒܸܠܘܿܢ ܗܵܩܵܝ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "3",
            "verseNumberAs": "ܓ",
            "verseText": "<red>ܐܝܼܢܵܐ ܐܲܢ݇ܬ: ܐܝܼܡܲܢ ܕܥܵܒ̣ܕܸܬ ܐܸܪܘܵܢܵܐ: ܠܵܐ ܝܲܕܥܵܐ ܣܸܡܵܠܘܼܟ ܡܘܼܕܝܼ ܒܸܥܒ̣ܵܕܵܐ ܝܠܵܐ ܝܲܡܝܼܢܘܼܟ:</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "4",
            "verseNumberAs": "ܕ",
            "verseText": "<red>ܕܗܵܘܹܐ ܐܸܪܘܵܢܘܼܟ ܒܛܸܫܘܵܐ: ܘܒܵܒܘܼܟ ܕܚܵܙܹܐ ܒܛܸܫܘܵܐ: ܗ̇ܘ ܒܸܬ ܦܲܪܸܥ ܠܘܼܟ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "5",
            "verseNumberAs": "ܗ",
            "verseText": "<red>ܘܐܝܼܡܲܢ ܕܨܵܠܸܬ ܨܠܘܿܬܵܟ: ܠܵܐ ܗܵܘܸܬ ܐܲܝܟ ܢܵܣܒܲܝ̈ ܒܐܲܦܹ̈ܐ: ܕܡܲܚܸܒܝܼ ܠܸܟܠܵܝܵܐ ܒܟܢܘܼܫܝܵܬܹ̈ܐ ܘܒܩܘܼܢܓ̰ܝܼܵܬܹ̈ܐ ܕܥܵܠܘܠܹ̈ܐ ܠܨܵܠܘܿܝܹܐ: ܕܦܵܝܫܝܼ ܚܸܙܝܹܐ ܠܒܢܲܝ̈ܢܵܫܵܐ. ܬܪܘܼܨܵܐ ܒܹܐܡܵܪܵܐ ܝܘܸ‍ܢ ܐܸܠܵܘܟ̣ܘܿܢ ܕܩܘܼܒܸܠܘܿܢ ܗܵܩܵܝ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "6",
            "verseNumberAs": "ܘ",
            "verseText": "<red>ܐܝܼܢܵܐ ܐܲܢ݇ܬ: ܐܝܼܡܲܢ ܕܨܵܠܸܬ: ܐܘܘܿܪ ܠܟܘܼܚܬܘܼܟ ܘܥܟ̰ܘܿܡ ܬܲܪܥܘܼܟ: ܘܨܵܠܝܼ ܠܒܵܒܘܼܟ ܕܒܛܸܫܘܵܐ: ܘܒܵܒܘܼܟ ܕܚܵܙܹܐ ܒܛܸܫܘܵܐ ܒܸܬ ܦܲܪܸܥ ܠܘܼܟ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "7",
            "verseNumberAs": "ܙ",
            "verseText": "<red>ܘܐܝܼܡܲܢ ܕܨܵܠܝܼܬܘܿܢ: ܠܵܐ ܗܵܘܝܼܬܘܿܢ ܒܸܬܢܵܝܵܐ ܗܹܡܸܙܡܵܢ ܐܲܝܟ ܛܵܝܸܦܹ̈ܐ: ܣܵܒܵܒ̇ ܕܟܹܐ ܚܵܫܒ̣ܝܼ ܕܒܗܲܡܙܲܡܬܵܐ ܪܵܒܵܐ ܦܵܝܫܝܼ ܫܸܡܥܝܹܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "8",
            "verseNumberAs": "ܚ",
            "verseText": "<red>ܗܲܕܟ̣ܵܐ ܠܵܐ ܕܵܡܝܼܬܘܿܢ ܐܸܠܵܝ: ܣܵܒܵܒ̇ ܒܵܒܵܘܟ̣ܘܿܢ ܟܹܐ ܝܲܕܸܥ ܡܘܼܕܝܼ ܠܵܙܸܡ ܝܼܠܹܐ ܐܸܠܵܘܟ̣ܘܿܢ: ܗܹܫ ܠܵܐ ܛܵܠܒܝܼܬܘܿܢ ܡܸܢܹܗ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "9",
            "verseNumberAs": "ܛ",
            "verseText": "<red>ܒܲܣ ܗܲܕܟ̣ܵܐ ܨܵܠܹܡܘܿܢ ܐܲܚܬܘܿܢ: ܒܵܒܲܢ ܕܒܫܡܲܝܵܐ: ܦܵܝܫܸ ܡܩܘܼܕܫܵܐ ܫܸܡܘܼܟ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "10",
            "verseNumberAs": "ܝ",
            "verseText": "<red>ܐܵܬܝܵܐ ܡܲܠܟܘܼܬܘܼܟ. ܗܵܘܹܐ ܪܸܙܵܝܘܼܟ: ܕܵܐܟ̣ܝܼ ܕܒܫܡܲܝܵܐ ܐܘܼܦ ܒܐܲܪܥܵܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "11",
            "verseNumberAs": "ܝܐ",
            "verseText": "<red>ܗܲܒ݇ܠ ܠܲܢ ܠܲܚܡܵܐ ܕܣܘܼܢܩܵܢܲܢ ܐܸܕܝܘܼ ܝܘܿܡܵܐ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "12",
            "verseNumberAs": "ܝܒ",
            "verseText": "<red>ܘܫܒ̣ܘܿܩ ܠܲܢ ܚܵܘܒܲܝ̈ܢ: ܕܵܐܟ̣ܝܼ ܕܐܘܼܦ ܐܲܚܢܲܢ ܫܒܸܩܠܲܢ ܠܕܵܝܢܵܢܕܵܪܲ̈‍ܢ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "13",
            "verseNumberAs": "ܝܓ",
            "verseText": "<red>ܘܠܵܐ ܡܲܐܘܸܪܸܬ ܠܲܢ ܠܓ̰ܘܼܪܵܒܵܐ: ܐܸܠܵܐ ܦܵܨܝܼ ܠܲܢ ܡ̣ܢ ܒܝܼܫܬܵܐ. ܣܵܒܵܒ̇ ܕܝܼܘܼܟ ܝܼܠܵܐ ܡܲܠܟܘܼܬܵܐ: ܘܚܲܝܠܵܐ: ܘܬܸܫܒܘܿܚܬܵܐ: ܠܥܵܠܲܡ ܥܵܠܡܝܼܢ: ܐܵܡܹܝܢ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "14",
            "verseNumberAs": "ܝܕ",
            "verseText": "<red>ܣܵܒܵܒ̇ ܕܐܸ‍ܢ ܫܵܒ̣ܩܝܼܬܘܿܢ ܠܒܢܲܝ̈ܢܵܫܵܐ ܓܢܵܗܵܝ̈: ܐܘܼܦ ܒܵܒܵܘܟ̣ܘܿܢ ܕܒܫܡܲܝܵܐ ܒܸܬ ܫܵܒܸܩ ܠܵܘܟ̣ܘܿܢ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "15",
            "verseNumberAs": "ܝܗ",
            "verseText": "<red>ܐܝܼܢܵܐ ܐܸ‍ܢ ܠܵܐ ܫܵܒ̣ܩܝܼܬܘܿܢ ܠܒܢܲܝ̈ܢܵܫܵܐ ܓܢܵܗܵܝ̈: ܐܘܼܦ ܒܵܒܵܘܟ̣ܘܿܢ ܠܹܐ ܫܵܒܸܩ ܠܵܘܟ̣ܘܿܢ ܓܢܵܗܵܘ̈ܟ̣ܘܿܢ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "16",
            "verseNumberAs": "ܝܘ",
            "verseText": "<red>ܘܐܝܼܡܲܢ ܕܨܵܝܡܝܼܬܘܿܢ: ܠܵܐ ܗܵܘܝܼܬܘܿܢ ܦܫܝܼܡܹ̈ܐ ܐܲܝܟ ܢܵܣܒܲܝ̈ ܒܐܲܦܹ̈ܐ: ܣܵܒܵܒ̇ ܕܟܹܐ ܡܲܣܪܝܼ ܚܘܼܠܩܵܝ: ܕܦܵܝܫܝܼ ܚܸܙܝܹܐ ܠܒܢܲܝ̈ܢܵܫܵܐ ܕܒܸܨܝܵܡܵܐ ܝܢܵܐ. ܬܪܘܼܨܵܐ ܒܹܐܡܵܪܵܐ ܝܘܸ‍ܢ ܐܸܠܵܘܟ̣ܘܿܢ ܕܩܘܼܒܸܠܘܿܢ ܗܵܩܵܝ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "17",
            "verseNumberAs": "ܝܙ",
            "verseText": "<red>ܐܝܼܢܵܐ ܐܲܢ݇ܬ: ܐܝܼܡܲܢ ܕܨܵܝܡܸܬ: ܚܲܠܸܠ ܦܵܬܘܼܟ ܘܡܫܘܿܚ ܪܹܫܘܼܟ:</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "18",
            "verseNumberAs": "ܝܚ",
            "verseText": "<red>ܕܠܵܐ ܦܵܝܫܸܬ ܚܸܙܝܵܐ ܠܒܢܲܝ̈ܢܵܫܵܐ ܕܒܸܨܝܵܡܵܐ ܝܘܸܬ: ܐܸܠܵܐ ܠܒܵܒܘܼܟ ܕܒܛܸܫܘܵܐ: ܘܒܵܒܘܼܟ ܕܚܵܙܹܐ ܒܛܸܫܘܵܐ: ܗ̇ܘ ܒܸܬ ܦܲܪܸܥ ܠܘܼܟ.</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
        {
            "verseNumberEn": "19",
            "verseNumberAs": "ܝܛ",
            "verseText": "<red>ܠܵܐ ܡܲܬܒ̣ܝܼܬܘܿܢ ܠܵܘܟ̣ܘܿܢ ܚܲܙܝܼܢܹ̈ܐ ܒܐܼ̈ܿܪܥܵܐ: ܐܲܝܟܵܐ ܕܓ̰ܼܿܢܓ ܘܐܸܟ̣ܠܵܐ ܡܲܚܪܸܒ̣ܝܼ: ܘܐܲܝܟܵܐ ܕܓܹܢܵܒܹ̈ܐ ܒܲܙܥܝܼ ܘܓܵܢܒ̣ܝܼ:</red>",
            "isRedLetter": false,
            "verseNote": ""
        },
